# Select sqlite for local development or mysql for CloudBase MySQL.
SNOOZMATE_DB_BACKEND=sqlite
SNOOZMATE_DB_PATH=./data/snoozmate.db
SNOOZMATE_PERSISTENT_VOLUME=false
SNOOZMATE_SEED_DEMO_DATA=false
SNOOZMATE_DEFAULT_DEVICE_ID=device_esp32_real_001
SNOOZMATE_DEVICE_ONLINE_TTL_SECONDS=300
SNOOZMATE_NIGHT_TIMEZONE=Asia/Shanghai
SNOOZMATE_NIGHT_START_HOUR=18
SNOOZMATE_NIGHT_END_HOUR=12

# WeChat Cloud Hosting MySQL target (requires the MySQL database adapter).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT_SECONDS=4
DB_READ_TIMEOUT_SECONDS=8
DB_WRITE_TIMEOUT_SECONDS=8
DB_POOL_SIZE=6

# OpenAI-compatible model. All three values must belong to the same provider.
SNOOZMATE_LLM_PROVIDER=volcengine-ark
SNOOZMATE_LLM_KEY=
SNOOZMATE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
SNOOZMATE_LLM_MODEL=
SNOOZMATE_LLM_CONNECT_TIMEOUT_SECONDS=2
SNOOZMATE_LLM_READ_TIMEOUT_SECONDS=20
SNOOZMATE_LLM_OVERALL_TIMEOUT_SECONDS=30

# Enables test_code_* logins. Leave unset/false in production.
SNOOZMATE_ALLOW_TEST_LOGIN=false

# Required for stable production WeChat identity.
SNOOZMATE_WECHAT_APP_ID=
SNOOZMATE_WECHAT_APP_SECRET=
